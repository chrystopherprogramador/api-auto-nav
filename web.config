<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.web>
		<!-- Exibe detalhes de erro no navegador (útil em desenvolvimento) -->
		<customErrors mode="Off" />
		<!-- Se você usa .NET e quiser setar o runtime: <compilation targetFramework="4.7.2" /> -->
	</system.web>

	<system.webServer>
		<!-- Exibe erros detalhados no IIS -->
		<httpErrors errorMode="Detailed" />

		<rewrite>
			<rules>
				<rule name="Rewrite para .php" stopProcessing="true">
					<match url="^(.*)$" ignoreCase="true" />
					<conditions>
						<add input="{REQUEST_URI}" pattern="\.php$" negate="true" />
						<add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
					</conditions>
					<action type="Rewrite" url="{R:0}.php" appendQueryString="true" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>
