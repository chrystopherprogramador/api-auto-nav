<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Adicionar Extensão .php se necessário" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="true" />
          <conditions>
            <!-- Aplica a regra somente se a URL não terminar com .php -->
            <add input="{REQUEST_URI}" pattern="\.php$" negate="true" />
            <!-- Verifica se existe um arquivo correspondente ao adicionar .php -->
            <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
          </conditions>
          <!-- Reescreve a URL adicionando a extensão .php -->
          <action type="Rewrite" url="{R:0}.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
